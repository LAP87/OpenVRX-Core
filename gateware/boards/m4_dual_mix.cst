// RX5808 x2, shared CLK/DATA/SEL (as M3 and M6): CLK J5-18 PIN71, DATA J6-17 PIN19 (LED4's pin),
// SEL J6-16 PIN20 (LED5's pin)
IO_LOC  "rx_spi_clk" 71;
IO_PORT "rx_spi_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "rx_spi_data" 19;
